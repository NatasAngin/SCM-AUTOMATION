{
  "name": "scm-automation-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 migrations apply scm-automation-db --local",
    "db:remote": "wrangler d1 migrations apply scm-automation-db --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20261031.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.45.0"
  }
}
