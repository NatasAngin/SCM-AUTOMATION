{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scm-automation-preview",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scm-automation-db",
      "database_id": "c1d0d506-06fd-4282-b4b8-e7d7aff6d5b3",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8"
  }
}
